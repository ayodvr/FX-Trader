# Tradbot environment variables — copy to .env and fill in your values.
# Never commit a .env with real credentials to version control.

# ── Bybit API ─────────────────────────────────────────────────────────────────
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Set to false ONLY after you have fully validated on testnet
BYBIT_TESTNET=true

# ── Bot safety ────────────────────────────────────────────────────────────────
# Keep true until you are confident in the strategy on testnet.
# Set DRY_RUN=false AND BYBIT_TESTNET=false together to go live.
DRY_RUN=true

# ── Telegram alerts (optional but strongly recommended for live trading) ──────
# Leave blank to disable alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Strategy ──────────────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
TIMEFRAME=15
FAST_EMA=9
SLOW_EMA=21
ATR_PERIOD=14
ATR_STOP_MULT=2.0
ATR_TRAIL_MULT=3.0
LONG_ONLY=false

# ── Signal quality filters ────────────────────────────────────────────────────
# 1.5 = require volume 50% above the 20-candle average (real smart-money filter).
# Lowering below 1.2 significantly degrades signal quality. 1.0 = disabled.
MIN_VOLUME_SPIKE=1.5
MIN_ADX=10.0

# ── Risk management ───────────────────────────────────────────────────────────
LEVERAGE=5
RISK_PER_TRADE=0.0075       # 0.75% of equity risked per trade
MAX_POSITION_PCT=0.25       # max 25% of equity as notional per position
MAX_DAILY_LOSS=0.03         # kill switch fires at -3% daily loss
MAX_OPEN_POSITIONS=1
# Minimum stop distance as % of entry price (rejects stops too tight for leverage)
MIN_STOP_PCT=0.003          # 0.3% minimum

# ── Quant Scanner settings ────────────────────────────────────────────────────
TOP_SYMBOLS_COUNT=30        # number of top-volume USDT perp symbols to scan
MAX_HOLD_HOURS=3.0          # auto-close stagnant trades after this many hours
MAX_ACTIVE_TRADES=2         # max simultaneous open scanner positions

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
